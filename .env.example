APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=image_prompt_crm
DB_USERNAME=root
DB_PASSWORD=root
DB_SOCKET=/Applications/MAMP/tmp/mysql/mysql.sock

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=300

CACHE_STORE=database
# CACHE_PREFIX=

PROMPT_LIBRARY_AI_PROVIDER=nvidia
PROMPT_LIBRARY_AI_MODEL=thinkingmachines/inkling
PROMPT_LIBRARY_AI_TIMEOUT=120
PROMPT_LIBRARY_IMAGE_PROVIDER=nvidia
PROMPT_LIBRARY_IMAGE_MODEL=black-forest-labs/flux.1-dev
PROMPT_LIBRARY_IMAGE_TIMEOUT=180
PROMPT_LIVE_URL=http://127.0.0.1:8081
PROMPT_API_TOKEN=
PROMPT_API_USER_ID=
PROMPT_LIVE_TIMEOUT=30
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=thinkingmachines/inkling
NVIDIA_IMAGE_API_KEY=${NVIDIA_API_KEY}
NVIDIA_IMAGE_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.1-dev
NVIDIA_IMAGE_MODEL=black-forest-labs/flux.1-dev
NVIDIA_IMAGE_WIDTH=832
NVIDIA_IMAGE_HEIGHT=1216
NVIDIA_IMAGE_STEPS=50
NVIDIA_IMAGE_CFG_SCALE=5
NVIDIA_IMAGE_PROMPT_LIMIT=10000

ADSENSE_ENABLED=false
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_HOME=
ADSENSE_SLOT_LIBRARY=
ADSENSE_SLOT_DETAIL=
ADSENSE_TEST_MODE=false

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
